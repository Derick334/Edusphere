{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "primary",
        "junior_secondary",
        "senior_secondary",
        "post_secondary"
      ]
    },
    "grade_form": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "term": {
      "type": "string",
      "enum": [
        "term_1",
        "term_2",
        "term_3",
        "mock",
        "final"
      ]
    },
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "paper_file": {
      "type": "string",
      "format": "file_url"
    },
    "answers_file": {
      "type": "string",
      "format": "file_url"
    },
    "solutions_text": {
      "type": "string"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "download_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "subject",
    "level",
    "year"
  ],
  "name": "PastPaper",
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "teacher"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}