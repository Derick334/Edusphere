{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_years": {
      "type": "number"
    },
    "bio": {
      "type": "string"
    },
    "hourly_rate": {
      "type": "number"
    },
    "teaching_mode": {
      "type": "string",
      "enum": [
        "online",
        "physical",
        "both"
      ],
      "default": "both"
    },
    "location": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "available_times": {
      "type": "object",
      "properties": {
        "weekday_morning": {
          "type": "boolean",
          "default": false
        },
        "weekday_afternoon": {
          "type": "boolean",
          "default": false
        },
        "weekday_evening": {
          "type": "boolean",
          "default": false
        },
        "weekend_morning": {
          "type": "boolean",
          "default": false
        },
        "weekend_afternoon": {
          "type": "boolean",
          "default": false
        },
        "weekend_evening": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "profile_photo": {
      "type": "string",
      "format": "file_url"
    },
    "credentials": {
      "type": "string",
      "format": "file_url"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "levels_taught": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teaching_methodologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_style_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intro_video_url": {
      "type": "string"
    },
    "trial_session_available": {
      "type": "boolean",
      "default": false
    },
    "trial_session_rate": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "hourly_rate"
  ],
  "name": "Tutor",
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.is_verified": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}