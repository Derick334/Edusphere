    },
    "question": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "ai_provider": {
      "type": "string",
      "enum": [
        "chatgpt",
        "gemini",
        "perplexity"
      ],
      "default": "chatgpt"
    },
    "response": {
      "type": "string"
    },
    "voice_url": {
      "type": "string"
    },
    "has_voice": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "question"
  ],
  "name": "AIConversation",
