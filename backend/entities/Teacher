{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "school_code": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phone": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string",
      "format": "file_url"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  "name": "Teacher",
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}