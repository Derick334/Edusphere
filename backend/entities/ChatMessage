{
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "class",
        "school",
        "subject",
        "direct"
      ]
    },
    "room_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string",
      "format": "file_url"
    }
  },
  "required": [
    "sender_id",
    "room_type",
    "room_id",
    "message"
  ],
  "name": "ChatMessage",
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}